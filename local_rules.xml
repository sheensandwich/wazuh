<!-- NESSUS ALLOWLIST -->
<group name="nessus_whitelist,">
  <!-- Suppress specific MikroTik/Network rule alerts generated by Nessus scanner -->
    <rule id="100010" level="0">
    <if_sid>110003, 110050, 110053, 110060</if_sid>
    <if_group>syslog</if_group>
    <srcip>10.0.0.20</srcip>
    <description>Ignore Nessus scanning activity from authorized IP</description>
  </rule>
</group>

<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

<!-- Mute netstat listening ports output flood -->
<rule id="100095" level="0">
  <if_sid>533</if_sid>
  <match>netstat listening ports</match>
  <description>Ignore routine listening port changes and netstat noise.</description>
</rule>

  <!-- Escalate Linux/Debian SSH Authentication Failures to Critical -->
  <rule id="100022" level="15">
    <if_sid>5716, 5760, 5503</if_sid>
    <description>Linux/Debian: CRITICAL ALERT - SSH authentication failed / unauthorized access attempt.</description>
    <group>authentication_failed,ssh,syslog,</group>
  </rule>

  <!-- Escalate Windows Authentication Failures to Critical -->
  <rule id="100023" level="15">
    <if_sid>18111, 60122</if_sid>
    <description>Windows: CRITICAL ALERT - Failed login attempt (Event ID 4625 / Potential Brute Force).</description>
    <group>authentication_failed,windows,</group>
  </rule>

  <!-- LINUX RULESET -->

  <!-- ======================================================== -->
  <!-- 1. Privilege Escalation & Sudo Abuse Monitoring         -->
  <!-- ======================================================== -->

  <!-- Escalate Failed Sudo Attempts (Potential Privilege Escalation) -->
  <rule id="100030" level="15">
    <if_sid>5403</if_sid>
    <description>Linux: CRITICAL ALERT - Unauthorized Sudo Execution Attempt / Password Failure.</description>
    <group>syslog,sudo,invalid_access,</group>
  </rule>

  <!-- Escalate Successful Root Switches via 'su' -->
  <rule id="100031" level="15">
    <if_sid>5302</if_sid>
    <match>to root</match>
    <description>Linux: CRITICAL ALERT - User successfully changed session identity to root via su.</description>
    <group>syslog,su,authentication_success,</group>
  </rule>

  <!-- ======================================================== -->
  <!-- 2. Operational Anti-Forensics Detection                  -->
  <!-- ======================================================== -->

  <!-- Detect Clear/Wipe Log commands or History Deletion -->
  <rule id="100040" level="15">
    <if_sid>2931, 2932</if_sid>
    <description>Linux: CRITICAL ALERT - System audit or log trails cleared (Anti-Forensics activity).</description>
    <group>syslog,audit,tampering,</group>
  </rule>

  <rule id="100041" level="15">
    <if_sid>5100</if_sid>
    <match>rm -rf /var/log|history -c|&gt; /var/log/</match>
    <description>Linux: CRITICAL ALERT - Shell command executed attempting to erase system history files.</description>
    <group>syslog,command,tampering,</group>
  </rule>

  <!-- ======================================================== -->
  <!-- 3. Web Shell & Directory Execution Anomalies             -->
  <!-- ======================================================== -->

  <!-- Detect execution attempts out of volatile runtime directories -->
  <rule id="100050" level="15">
    <if_sid>5100</if_sid>
    <match>/tmp/|/var/tmp/|/dev/shm/</match>
    <description>Linux: CRITICAL ALERT - Executable script launched out of temporary/untrusted filesystem path.</description>
    <group>syslog,command,malware_execution,</group>
  </rule>

  <!-- ======================================================== -->
  <!-- 4. Suspicious Software and Toolkit Deployment            -->
  <!-- ======================================================== -->

  <!-- Detect downloads of hacking tools or network pivoting utilities -->
  <rule id="100060" level="15">
    <if_sid>5100</if_sid>
    <match>wget |curl |nmap |nc -e|netcat |socat |mimikatz|chisel</match>
    <description>Linux: CRITICAL ALERT - Suspicious binary download or network reconnaissance utility executed via shell.</description>
    <group>syslog,command,network_pivoting,</group>
  </rule>

  <!-- /usr/bin/chsh ADJUSTMENT -->

  <rule id="100020" level="0">
    <if_sid>510</if_sid>
    <hostname>ss-sn-020</hostname>
     <match>Trojaned version of file /usr/bin/chsh detected|Trojaned version of file /usr/bin/chfn detected</match>
    <description>Ignore signature false positives for chsh and chfn on agent ss-sn-020; relying on Syscheck for file integrity.</description>
  </rule>

  <!-- WINDOWS POWERSHELL DETECTS -->


  <!-- ======================================================== -->
  <!-- Encrypted / Obfuscated PowerShell Command Detections     -->
  <!-- ======================================================== -->

  <!-- Detect Base64 Encoded PowerShell Flags in Process Creation (Event ID 4688) -->
  <rule id="100080" level="15">
    <if_group>windows</if_group>
    <match type="pcre2">(?i)powershell.*(-encodedcommand|-enc|-e|-en)\s+</match>
    <description>Windows: CRITICAL ALERT - Obfuscated/Base64 Encoded PowerShell Command Executed!</description>
    <group>windows,powershell,defense_evasion,t1059.001,</group>
  </rule>

  <!-- Detect Encoded/Malicious Execution inside Script Block Logs (Event ID 4104) -->
  <rule id="100081" level="15">
    <if_sid>60001, 60002</if_sid>
    <match type="pcre2">(?i)(-encodedcommand|-enc|-e|-en)\s+|FromBase64String</match>
    <description>Windows: CRITICAL ALERT - Script Block Execution contains Base64 Encoding or Decryption logic.</description>
    <group>windows,powershell,defense_evasion,t1059.001,</group>
  </rule>

  <!-- Detect Execution Policy Bypasses paired with Hidden Windows -->
  <rule id="100082" level="15">
    <if_group>windows</if_group>
    <match type="pcre2">(?i)-executionpolicy\s+bypass\s+-windowstyle\s+hidden|-ep\s+bypass\s+-w\s+hidden</match>
    <description>Windows: CRITICAL ALERT - PowerShell launched with Execution Policy Bypass and Hidden Window flags.</description>
    <group>windows,powershell,defense_evasion,t1562.001,</group>
  </rule>

  

  <!-- WINDOWS SCHEDULED TASKS DETECTS -->


  <!-- ======================================================== -->
  <!-- Scheduled Task Creation & Persistence Monitoring         -->
  <!-- ======================================================== -->

  <!-- Broad Catch-All: Elevate all new Scheduled Tasks to Level 15 -->
  <rule id="100090" level="15">
    <if_sid>60113</if_sid>
    <description>Windows: CRITICAL ALERT - A new Scheduled Task was created (Persistence Attempt).</description>
    <group>windows,windows_tasks,persistence,t1053.005,</group>
  </rule>

  <!-- High-Risk Directory: Task executing binaries from unsafe/untrusted paths -->
  <rule id="100091" level="15">
    <if_sid>100090</if_sid>
    <match type="pcre2">(?i)\\AppData\\Local\\Temp|\\Windows\\Temp|\\Users\\Public</match>
    <description>Windows: CRITICAL ALERT - Scheduled Task created executing out of an untrusted user path!</description>
    <group>windows,windows_tasks,persistence,defense_evasion,t1053.005,</group>
  </rule>

  <!-- Script Execution: Scheduled Task running PowerShell or CMD directly -->
  <rule id="100092" level="15">
    <if_sid>100090</if_sid>
    <match type="pcre2">(?i)powershell\.exe|cmd\.exe|wscript\.exe|cscript\.exe|mshta\.exe</match>
    <description>Windows: CRITICAL ALERT - Scheduled Task created executing a command shell script or administrative tool!</description>
    <group>windows,windows_tasks,persistence,execution,t1053.005,</group>
  </rule>  

 <!-- ======================================================== -->
  <!-- macOS (OSX) Advanced Threat Monitoring                    -->
  <!-- ======================================================== -->

  <!-- 1. LaunchAgent / LaunchDaemon Persistence Modification -->
  <rule id="100110" level="15">
    <if_sid>550, 554</if_sid>
    <match type="pcre2">(?i)/Library/LaunchAgents/|/Library/LaunchDaemons/|~/Library/LaunchAgents/</match>
    <description>macOS: CRITICAL ALERT - Persistence Attempt: New background LaunchAgent or LaunchDaemon added/modified.</description>
    <group>osx,macos,persistence,fim,t1543.001,</group>
  </rule>

  <!-- RULE FOR NEW CON -->
<rule id="100011" level="3">
  <decoded_as>mikrotik-firewall</decoded_as>
  <description>MikroTik Outgoing Network Connection Detected</description>
</rule>


  <!-- Clean MikroTik Portscan Rule with Built-in 10.0.0.20 Tuning -->
  <rule id="110053" level="15">
    <decoded_as>mikrotik</decoded_as>
    <match>internal_portscan</match>
    <!-- Ignore the alert if the log contains the trusted host 10.0.0.20 -->
    <regex type="pcre2">^(?!.*10\.0\.0\.20)</regex>
    <description>MikroTik: CRITICAL ALERT - Internal Port Scan detected on LAN interface! Local host reconnaissance activity.</description>
  </rule>

  <!-- suppress /var/tmp fp on mac -->
  <rule id="100123" level="0">
    <if_sid>510</if_sid>
    <match>Files hidden inside directory '/var/tmp'</match>
    <description>Ignore macOS Rootcheck false positives in /var/tmp</description>
  </rule>
  

</group>

